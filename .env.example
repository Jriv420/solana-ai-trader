PAPER_MODE=true
LIVE_TRADING_ENABLED=false
WATCHLIST_MINTS=
HELIUS_API_KEY=
SOLANA_RPC_URL=
JEV_API_KEY=
JEV_ENDPOINT=https://api.openjev.sh/v1/systemone
LAYA_API_KEY=
LAYA_ENDPOINT=
DARWIN_API_KEY=
DARWIN_ENDPOINT=

# Public wallet addresses, optionally with a label. Never use private keys here.
TRACKED_WALLETS=[]

# Automatic wallet discovery and learning use SOLANA_RPC_URL and HELIUS_API_KEY above.
WHALE_POSITION_USD=25000
WHALE_PORTFOLIO_USD=100000
WALLET_MIN_MATCHED_SELLS=10

# Optional live X recent-search access; keep the bearer token private.
X_BEARER_TOKEN=
# Comma-separated immutable X author IDs you want watched as KOLs.
X_KOL_IDS=
# If Railway has a volume, its automatic mount path is used unless DB_PATH is set.
# DB_PATH=/data/trades.sqlite3
REVIVAL_MIN_VOLUME_5M_USD=5000
REVIVAL_VOLUME_RATIO=2
PAPER_FEE_BPS=100
PAPER_SLIPPAGE_BPS=100
STOP_LOSS_PCT=20
TAKE_PROFIT_PCT=50
TRAILING_STOP_PCT=20
PAPER_MAX_HOLD_MINUTES=1440

# Optional OpenAI second opinion; API billing is separate from ChatGPT Plus.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_DAILY_REQUEST_LIMIT=10
OPENAI_TIMEOUT_MS=15000
